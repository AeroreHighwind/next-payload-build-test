# Base URL of the Payload CMS (no trailing slash). Only needed at build/sync time.
PAYLOAD_URL=http://localhost:3000
# Collection slug that holds your pages
PAYLOAD_PAGES_COLLECTION=pages
# Optional: Payload API key (Authorization: <collection> API-Key <key>)
PAYLOAD_API_KEY=
PAYLOAD_API_KEY_COLLECTION=users
# Relationship depth to populate (media inside blocks / rich text needs >= 2)
PAYLOAD_DEPTH=3
